DATABASE_PROVIDER=sqlite
SQLITE_DATABASE_PATH=./data/dev.db

AI_GENERATION_TIMEOUT_MS=120000

# ============================================================
# Production PostgreSQL (Vercel Postgres)
# ============================================================
# On Vercel, DATABASE_PROVIDER=postgres and DATABASE_URL are set in the
# project's Environment Variables (Vercel dashboard -> Project -> Settings
# -> Environment Variables, or Storage -> Postgres -> Connect -> .env.local).
# The app runtime reads DATABASE_URL only; drizzle-kit also accepts
# POSTGRES_URL (the value Vercel auto-exposes) as a fallback.
#
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require
#
# Local PostgreSQL example (see SETUP.md section 3/4):
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ============================================================
# AI Provider Credentials — Server-side only, never expose to browser
# ============================================================

# Google Gemini (official API) — https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=your_real_google_api_key_here
# GEMINI_BASE_URL=   # Leave empty to use the official Google endpoint

# OpenAI-compatible API (FreeModel, OpenRouter, or official OpenAI)
# AI_OPENAI_API_KEY=fe_oa_a8c2504d0b0aaa5ae19730276c09e6a517013fb5786e966a
AI_OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
AI_OPENAI_MODEL=gpt-4o-mini
